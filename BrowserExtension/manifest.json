{
  "manifest_version": 3,
  "name": "sui Browser Bridge",
  "version": "0.1.0",
  "description": "Posts your sui push-to-talk transcript to X.com.",
  "key": "",
  "permissions": ["nativeMessaging", "tabs"],
  "host_permissions": ["https://x.com/*", "https://twitter.com/*"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [{
    "matches": ["https://x.com/*", "https://twitter.com/*"],
    "js": ["x-content.js"],
    "run_at": "document_idle"
  }],
  "action": { "default_title": "sui Browser Bridge" }
}

